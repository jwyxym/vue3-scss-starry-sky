{
  "name": "vue3-scss-starry-sky",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/vue3-scss-starry-sky.umd.cjs",
  "module": "./dist/vue3-scss-starry-sky.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/vue3-scss-starry-sky.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-scss-starry-sky.js",
      "require": "./dist/vue3-scss-starry-sky.umd.cjs"
    },
    "./style.css": "./dist/vue3-scss-starry-sky.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only build-types",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-types": "vue-tsc -p tsconfig.lib.json",
    "prepack": "npm run build",
    "type-check": "vue-tsc --build"
  },
  "peerDependencies": {
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "sass": "^1.100.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
